{
  "entities": {
    "Trip": {
      "title": "Trip",
      "description": "A travel itinerary",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "startDate": { "type": "string", "format": "date" },
        "endDate": { "type": "string", "format": "date" },
        "ownerId": { "type": "string" }
      },
      "required": ["title", "ownerId"]
    },
    "Event": {
      "title": "Event",
      "description": "An event in the trip schedule",
      "type": "object",
      "properties": {
        "time": { "type": "string" },
        "title": { "type": "string" },
        "cat": { "type": "string" },
        "location": { "type": "string" },
        "desc": { "type": "string" },
        "color": { "type": "string" },
        "icon": { "type": "string" },
        "dayIndex": { "type": "integer" }
      },
      "required": ["time", "title", "dayIndex"]
    },
    "Todo": {
      "title": "Todo",
      "description": "A packing item or task",
      "type": "object",
      "properties": {
        "text": { "type": "string" },
        "completed": { "type": "boolean" },
        "authorId": { "type": "string" }
      },
      "required": ["text", "authorId"]
    }
  },
  "firestore": {
    "trips/{tripId}": {
      "schema": "Trip",
      "description": "Main trip document"
    },
    "trips/{tripId}/events/{eventId}": {
      "schema": "Event",
      "description": "Schedule events for the trip"
    },
    "trips/{tripId}/todos/{todoId}": {
      "schema": "Todo",
      "description": "Planning tasks for the trip"
    }
  }
}
