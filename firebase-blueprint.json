{
  "entities": {
    "Trip": {
      "title": "Trip",
      "description": "The main trip container",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "startDate": { "type": "string", "format": "date" },
        "endDate": { "type": "string", "format": "date" },
        "destination": { "type": "string" },
        "ownerId": { "type": "string" },
        "members": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "startDate", "endDate", "ownerId"]
    },
    "ScheduleItem": {
      "title": "Schedule Item",
      "description": "An activity in the daily schedule",
      "type": "object",
      "properties": {
        "tripId": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "time": { "type": "string" },
        "title": { "type": "string" },
        "location": { "type": "string" },
        "category": { "type": "string", "enum": ["scenery", "food", "transport", "stay"] },
        "notes": { "type": "string" },
        "photos": { "type": "array", "items": { "type": "string" } },
        "mapUrl": { "type": "string" },
        "authorId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["tripId", "date", "title", "category", "authorId"]
    },
    "Booking": {
      "title": "Booking",
      "description": "Flight, stay, or ticket information",
      "type": "object",
      "properties": {
        "tripId": { "type": "string" },
        "type": { "type": "string", "enum": ["flight", "stay", "ticket"] },
        "title": { "type": "string" },
        "details": { "type": "object" },
        "vouchers": { "type": "array", "items": { "type": "string" } },
        "isPrivate": { "type": "boolean" },
        "authorId": { "type": "string" }
      },
      "required": ["tripId", "type", "title", "authorId"]
    },
    "Expense": {
      "title": "Expense",
      "description": "A travel expense record",
      "type": "object",
      "properties": {
        "tripId": { "type": "string" },
        "amount": { "type": "number" },
        "currency": { "type": "string" },
        "category": { "type": "string" },
        "payerId": { "type": "string" },
        "splitBetween": { "type": "array", "items": { "type": "string" } },
        "date": { "type": "string", "format": "date" },
        "note": { "type": "string" }
      },
      "required": ["tripId", "amount", "currency", "payerId"]
    },
    "JournalEntry": {
      "title": "Journal Entry",
      "description": "A daily log with photos",
      "type": "object",
      "properties": {
        "tripId": { "type": "string" },
        "content": { "type": "string" },
        "photos": { "type": "array", "items": { "type": "string" } },
        "date": { "type": "string", "format": "date" },
        "authorId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["tripId", "content", "authorId"]
    },
    "Member": {
      "title": "Member",
      "description": "User profile in a trip",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "avatar": { "type": "string" },
        "email": { "type": "string" }
      },
      "required": ["uid", "name"]
    },
    "Todo": {
      "title": "Todo",
      "description": "A planning list item",
      "type": "object",
      "properties": {
        "tripId": { "type": "string" },
        "type": { "type": "string", "enum": ["todo", "packing", "shopping"] },
        "text": { "type": "string" },
        "completed": { "type": "boolean" }
      },
      "required": ["tripId", "type", "text"]
    }
  },
  "firestore": {
    "/trips/{tripId}": {
      "schema": "Trip",
      "description": "Main trip data"
    },
    "/trips/{tripId}/schedule": {
      "schema": "ScheduleItem",
      "description": "Daily schedule for the trip"
    },
    "/trips/{tripId}/bookings": {
      "schema": "Booking",
      "description": "Bookings for the trip"
    },
    "/trips/{tripId}/expenses": {
      "schema": "Expense",
      "description": "Expenses for the trip"
    },
    "/trips/{tripId}/journal": {
      "schema": "JournalEntry",
      "description": "Journal entries for the trip"
    },
    "/trips/{tripId}/todos": {
      "schema": "Todo",
      "description": "Planning lists for the trip"
    },
    "/users/{userId}": {
      "schema": "Member",
      "description": "User profile data"
    }
  }
}
